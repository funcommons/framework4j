<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!-- 动态追踪日志(framework4j-tracelog): TurboFilter/Appender 由 TraceLogBeansConfig
       编程式注册 (依赖 Spring Bean, logback 声明会因无无参构造失败), 此处无需声明 -->

  <!-- 控制台 appender -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{traceId:-}] - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

  <!-- 演示包 DEBUG 级别（默认会被拦截，提权后通过 DynamicLevelTurboFilter 放行） -->
  <logger name="fun.commons.framework4j.demo" level="DEBUG"/>
</configuration>